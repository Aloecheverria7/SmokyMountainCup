Options -Indexes
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(?:app|config|storage|tools|tests|docs)(?:/|$) - [F,L,NC]
RewriteRule ^php/ - [F,L,NC]
RewriteRule ^plugins/.*\.php$ - [F,L,NC]
<FilesMatch "\.(sql|sqlite|log|env|bak)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
