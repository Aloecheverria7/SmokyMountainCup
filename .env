NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# Generate a private random secret of at least 32 characters.
CSRF_SECRET=5X_aIMLUtFgdUvk1Bmxq-bBzJr0h-2kfh0PtaUV_4LiZ3fuq_Z6Wn2gKVP7G6XnM
# Optional read-only connection to a COPY of the seven-table legacy database.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# No mail is sent until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=smokymountaincup@yahoo.com
# New system database, separate from the legacy source. Used by compose.yaml.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3307
APP_DB_NAME=smoky_system
APP_DB_USER=smoky_app
APP_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Choose explicitly: legacy (read-only original data) or system (new published season).
PUBLIC_DATA_SOURCE=legacy

# Managed Node hosting: set LISTEN_HOST=0.0.0.0 and SERVE_WEB=1.
# Trust only the verified number of reverse-proxy hops (0 = direct access).
LISTEN_HOST=127.0.0.1
SERVE_WEB=0
TRUST_PROXY_HOPS=0
